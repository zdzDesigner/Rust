# 第 2 课：Monitor 命令练习脚本
# 这是一个交互式脚本，用于学习 Monitor 命令
#
# 使用方法：
#   1. 启动：renode --console renode/resc/lesson02_monitor.resc
#   2. 按照提示手动输入 Monitor 命令
#   3. 观察输出结果

using sysbus

echo "========================================"
echo "  第 2 课：Monitor 命令练习"
echo "========================================"
echo ""
echo "这是一个交互式练习脚本"
echo "请按照以下步骤在 Monitor 中手动输入命令"
echo ""
echo "========================================"
echo "  步骤 1: 创建机器"
echo "========================================"
echo ""
echo "在 Monitor 中输入:"
echo "  (monitor) mach create"
echo ""
echo "按 Enter 继续..."
sleep 2

echo ""
echo "========================================"
echo "  步骤 2: 加载平台"
echo "========================================"
echo ""
echo "在 Monitor 中输入:"
echo "  (monitor) machine LoadPlatformDescription @renode/stm32f103.repl"
echo ""
echo "这就像在仿真器里插上 STM32F103 开发板"
echo ""

echo ""
echo "========================================"
echo "  步骤 3: 加载固件"
echo "========================================"
echo ""
echo "在 Monitor 中输入:"
echo "  (monitor) sysbus LoadELF @zig-out/bin/stm32-zig-lesson02_monitor.elf"
echo ""
echo "观察输出中的 [INFO] 消息"
echo ""

echo ""
echo "========================================"
echo "  步骤 4: 运行前检查（重要！）"
echo "========================================"
echo ""
echo "在 Monitor 中输入，查看初始状态:"
echo "  (monitor) sysbus ReadDoubleWord 0x40010C04  # CRH - 应该是 0"
echo "  (monitor) sysbus ReadDoubleWord 0x40010C0C  # ODR - 应该是 0"
echo ""
echo "为什么是 0？因为程序还没运行！"
echo ""

echo ""
echo "========================================"
echo "  步骤 5: 运行程序"
echo "========================================"
echo ""
echo "在 Monitor 中输入:"
echo "  (monitor) start"
echo ""
echo "等待 2 秒..."
sleep 2

echo ""
echo "========================================"
echo "  步骤 6: 暂停并检查"
echo "========================================"
echo ""
echo "在 Monitor 中输入:"
echo "  (monitor) pause"
echo "  (monitor) sysbus ReadDoubleWord 0x40010C04  # CRH - 现在有值了吗？"
echo "  (monitor) sysbus ReadDoubleWord 0x40010C0C  # ODR - bit12 是 1 还是 0？"
echo ""

echo ""
echo "========================================"
echo "  步骤 7: 查看 CPU 状态"
echo "========================================"
echo ""
echo "在 Monitor 中输入:"
echo "  (monitor) cpu"
echo ""
echo "查看 PC (程序计数器) - 这是当前执行的指令地址"
echo ""

echo ""
echo "========================================"
echo "  步骤 8: 继续运行"
echo "========================================"
echo ""
echo "在 Monitor 中输入:"
echo "  (monitor) start"
echo ""
echo "等待 3 秒后暂停，再次检查 ODR"
echo ""
sleep 3

echo ""
echo "========================================"
echo "  练习完成！"
echo "========================================"
echo ""
echo "关键收获："
echo "1. mach create = 开机"
echo "2. LoadPlatformDescription = 插开发板"
echo "3. LoadELF = 烧录程序"
echo "4. start/pause = 运行/暂停"
echo "5. ReadDoubleWord = X 光透视寄存器"
echo ""
echo "继续输入 'quit' 退出，或继续探索！"
echo ""
